# Quando todos os serviços estão no host Linux com a 5070 Ti:
ASR_SERVER=host.docker.internal:50051
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
TTS_URL=http://host.docker.internal:8000/synthesize
ASR_LANGUAGE=pt-BR
TTS_LANGUAGE=Portuguese
TTS_SPEAKER=Ryan
SYSTEM_PROMPT=Você é um assistente de voz útil. Responda de forma natural e concisa em português brasileiro, sem markdown.
# Fim de fala (opcional): silêncio que encerra a fala e energia mínima considerada voz
# ASR_END_SILENCE_MS=800
# ASR_VAD_MIN_RMS=50
